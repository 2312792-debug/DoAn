PORT=4000
PINATA_JWT=dan_JWT_token_lay_tu_pinata.cloud_vao_day
FRONTEND_ORIGIN=http://localhost:5173
# Gateway doc file tu IPFS (mac dinh gateway cong khai cua Pinata, co the doi sang gateway rieng neu co)
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
# Bi mat goc de suy ra khoa ma hoa AES rieng cho tung van bang (xem backend/crypto.js).
# Dat 1 chuoi ngau nhien, DAI va GIU BI MAT that su (vd: openssl rand -hex 32). Mat chuoi nay
# = mat kha nang giai ma lai toan bo file da phat hanh truoc do, nen KHONG duoc doi sau khi
# da phat hanh van bang that, va KHONG duoc commit len Git.
FILE_ENC_MASTER_KEY=doi_thanh_1_chuoi_ngau_nhien_dai_it_nhat_32_ky_tu
# Khoa ky so (chu ky dien tu) cua nha truong. De trong -> tu tao va luu o data/signer.key (hay sao luu!).
# Dung: openssl rand -hex 32  (them 0x o dau). KHONG commit len Git, KHONG doi sau khi da cong bo dia chi ky.
SIGNING_PRIVATE_KEY=
# Co so du lieu SQLite (mien phi, 1 file). Mac dinh backend/data/diploma.db
DB_PATH=
# Duong dan contractInfo.json neu Backend chay tach roi thu muc frontend (vd trong Docker). Mac dinh doc frontend/src/contractInfo.json
CONTRACT_INFO_PATH=
# RPC rieng cho viec dong bo (mac dinh dung rpcUrl trong contractInfo.json)
RPC_URL=
